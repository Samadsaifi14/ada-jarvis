# Local execution bridge for ADA. Copy to .env and run: npm start
# Node 22+ loads this automatically via --env-file-if-exists.

# Tunnel target (ngrok/cloudflared forward to this port on 127.0.0.1)
PORT=8787
HOST=127.0.0.1

# Required. Shared with the Vercel app (BRIDGE_SECRET). Min 16 chars, do not commit.
BRIDGE_SECRET=

# Local ADA control plane
ADA_API_URL=http://127.0.0.1:47821
# Must match ADA_API_TOKEN in your ADA .env (leave empty if ADA has no token)
ADA_API_TOKEN=

RATE_LIMIT_PER_MIN=30
CHAT_TIMEOUT_MS=180000
FORWARD_TIMEOUT_MS=30000

# Optional: restrict which ADA tools the bridge will forward
# BRIDGE_TOOLS=tasks.list,tasks.create,memory.remember,system.safe_command
