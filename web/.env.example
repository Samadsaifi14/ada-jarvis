# Base HTTPS URL of your local bridge tunnel (no trailing path)
# e.g. https://abc123.ngrok-free.app  -> routes call /chat, /execute, /approvals
# Start local-bridge/server.js first, then expose with a tunnel (ngrok, cloudflare tunnels, etc.)
LOCAL_BRIDGE_URL=

# Shared secret, must match BRIDGE_SECRET in local-bridge (min 16 chars)
BRIDGE_SECRET=
